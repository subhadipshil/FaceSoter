# ==============================================================================
# FaceSoter — Git Ignore Configuration
# ==============================================================================

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# PyInstaller & Packaging Outputs (Never commit large compiled binaries to git)
build/
dist/
*.manifest
*.spec.bak

# Python Bytecode, Caches & Profiling
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local Application Data, Models & User Files
models/
thumbnails/
*.db
*.sqlite
*.sqlite3

# Application Logs
*.log
logs/

# Operating System & IDE Specific
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*~
